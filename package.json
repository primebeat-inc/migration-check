{
  "name": "migration-check",
  "private": true,
  "description": "サイトとメールの引っ越し判定（ブラウザで動く DNS の判定と、サイトの中身を読む Cloudflare Worker）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "check": "node scripts/check.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "stats": "node scripts/stats.mjs",
    "deploy": "node scripts/deploy.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  },
  "license": "MIT"
}
